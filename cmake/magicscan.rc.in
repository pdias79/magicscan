#include <windows.h>
#pragma code_page(65001) // Resource strings are authored in UTF-8.
#define IDI_MAGICSCAN 101

IDI_MAGICSCAN ICON "@MAGICSCAN_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040c04b0"
  BEGIN
   VALUE "CompanyName", "MagicScan"
   VALUE "FileDescription", "MagicScan - numérisation de documents"
   VALUE "FileVersion", "@PROJECT_VERSION@"
   VALUE "InternalName", "magicscan-tray"
   VALUE "OriginalFilename", "magicscan-tray.exe"
   VALUE "ProductName", "MagicScan"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x040c, 1200
 END
END
